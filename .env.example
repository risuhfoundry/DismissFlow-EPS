# Browser-safe (anon key, RLS-constrained). Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>

# Server-only. Never expose to the client. Used by Edge Functions and seeding.
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>

# Demo only (PRD §12): the parent Auth email is derived as
# <admission-number>@<this-domain>. Override for non-demo environments.
NEXT_PUBLIC_DEMO_EMAIL_DOMAIN=demo.dismissflow
